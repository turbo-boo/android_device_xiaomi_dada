@@ -13,7 +13,8 @@ import org.lunaris.dolby.data.DolbyRepository
 
 class DolbyTileService : TileService() {
 
-    private val repository by lazy { DolbyRepository(applicationContext) }
+    private val repositoryDelegate = lazy { DolbyRepository(applicationContext) }
+    private val repository by repositoryDelegate
 
     override fun onStartListening() {
         super.onStartListening()
@@ -27,6 +28,13 @@ class DolbyTileService : TileService() {
         updateTile()
     }
 
+    override fun onDestroy() {
+        if (repositoryDelegate.isInitialized()) {
+            repository.close()
+        }
+        super.onDestroy()
+    }
+
     private fun updateTile() {
         qsTile?.apply {
             val enabled = repository.getDolbyEnabled()
