             false
@@ -154,18 +168,44 @@ class DolbyRepository(private val context: Context) : AutoCloseable {
         }
     }
 
+    fun getDolbyUserEnabled(): Boolean {
+        return defaultPrefs.getBoolean(DolbyConstants.PREF_ENABLE, false)
+    }
+
     fun setDolbyEnabled(enabled: Boolean) {
         if (isReleased) return
         
         try {
             checkEffect()
-            dolbyEffect.dsOn = enabled
             defaultPrefs.edit().putBoolean(DolbyConstants.PREF_ENABLE, enabled).apply()
+            dolbyEffect.dsOn = enabled && !isAutoDisabledForCurrentRoute()
         } catch (e: Exception) {
             DolbyConstants.dlog(TAG, "Error setting Dolby enabled: ${e.message}")
         }
     }
 
+    fun isAutoDisabledForCurrentRoute(): Boolean {
+        return isAutoDisableNonSpeakerEnabled() &&
+            !isMediaRoutedToBuiltInSpeaker()
+    }
+
+    fun isAutoDisableNonSpeakerEnabled(): Boolean {
+        return defaultPrefs.getBoolean(DolbyConstants.PREF_AUTO_DISABLE_NON_SPEAKER, true)
+    }
+
+    private fun isMediaRoutedToBuiltInSpeaker(): Boolean {
+        return try {
+            val routedDevices = audioManager.getDevicesForAttributes(ATTRIBUTES_MEDIA)
+            routedDevices.isNotEmpty() && routedDevices.all { device ->
+                device.type == AudioDeviceInfo.TYPE_BUILTIN_SPEAKER ||
+                    device.type == AudioDeviceInfo.TYPE_BUILTIN_SPEAKER_SAFE
+            }
+        } catch (e: Exception) {
+            DolbyConstants.dlog(TAG, "Unable to determine media route; preserving Dolby state")
+            true
+        }
+    }
+
     fun getCurrentProfile(): Int {
         return try {
             checkEffect()
@@ -898,6 +938,7 @@ class DolbyRepository(private val context: Context) : AutoCloseable {
