From a450ed26ce599bd93cedf26149e7e95a5208e696 Mon Sep 17 00:00:00 2001
From: turbo-boo <59400127+turbo-boo@users.noreply.github.com>
Date: Wed, 19 Aug 2026 13:03:37 +0900
Subject: [PATCH] display: Support device-specific LTPO idle modes

Change-Id: Ic9a5066da8b30d487cad9999a548eed895b12fa3
---
 include/display_properties.h         |  1 +
 libdrmutils/drm_interface.h          |  1 +
 sde-drm/drm_connector.cpp            |  1 +
 sdm/include/core/display_interface.h |  1 +
 sdm/libs/dal/hw_device_drm.cpp       | 14 +++++++++++++-
 sdmclient/sdm_display.cpp            | 22 ++++++++++++++++++++++
 sdmclient/sdm_display.h              |  3 +++
 7 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/include/display_properties.h b/include/display_properties.h
index bbb3fe8..6f1bef1 100644
--- a/include/display_properties.h
+++ b/include/display_properties.h
@@ -246,6 +246,7 @@
 #define DISABLE_IDLE_TIME_HDR                DISPLAY_PROP("disable_idle_time_hdr")
 #define DISABLE_IDLE_TIME_VIDEO              DISPLAY_PROP("disable_idle_time_video")
 #define DISABLE_IDLE_FPS_SWITCH              DISPLAY_PROP("disable_idle_fps_switch")
+#define PRIMARY_IDLE_MODE_PROP                DISPLAY_PROP("primary_idle_mode")
 #define DISABLE_IDLE_SCALING_LAYERS          DISPLAY_PROP("disable_idle_scaling_layers")
 #define DISABLE_LLCC_DURING_AOD              DISPLAY_PROP("disable_llcc_during_aod")
 #define DISABLE_CWB_IDLE_FALLBACK            DISPLAY_PROP("disable_cwb_idle_fallback")
diff --git a/libdrmutils/drm_interface.h b/libdrmutils/drm_interface.h
index 1bbedb6..088e087 100644
--- a/libdrmutils/drm_interface.h
+++ b/libdrmutils/drm_interface.h
@@ -1003,6 +1003,7 @@ enum struct DMSType {
 /* Per mode info */
 struct DRMModeInfo {
   drmModeModeInfo mode;
+  std::string mode_name;
   // Valid only if mode is command
   int num_roi;
   int xstart;
diff --git a/sde-drm/drm_connector.cpp b/sde-drm/drm_connector.cpp
index dbae70f..7474ce1 100644
--- a/sde-drm/drm_connector.cpp
+++ b/sde-drm/drm_connector.cpp
@@ -833,6 +833,7 @@ void DRMConnector::ParseModeProperties(uint64_t blob_id, DRMConnectorInfo *info)
       }
       // Move to the next mode_item
       mode_item = &info->modes.at(index++);
+      mode_item->mode_name = name;
       submode_item = NULL;
       submode_index = 0;
     } else if (line.find(submode_string) != string::npos) {
diff --git a/sdm/include/core/display_interface.h b/sdm/include/core/display_interface.h
index 13430a1..576e5cc 100644
--- a/sdm/include/core/display_interface.h
+++ b/sdm/include/core/display_interface.h
@@ -271,6 +271,7 @@ struct DisplayConfigVariableInfo : public DisplayConfigGroupInfo {
   uint32_t fps = 0;               //!< Frame rate per second.
   uint32_t vsync_period_ns = 0;   //!< VSync period in nanoseconds.
   bool is_virtual_config = false;
+  bool is_idle_config = false;    //!< Physical panel mode used for the idle refresh state.
   int32_t parent_config_index = -1;   //!< if virtual config, then corresponding panel config
   uint32_t early_ept_timeout = 0;     //!< Early EPT timeout value ns
 
diff --git a/sdm/libs/dal/hw_device_drm.cpp b/sdm/libs/dal/hw_device_drm.cpp
index c21e9df..4429db5 100644
--- a/sdm/libs/dal/hw_device_drm.cpp
+++ b/sdm/libs/dal/hw_device_drm.cpp
@@ -910,6 +910,14 @@ DisplayError HWDeviceDRM::PopulateDisplayAttributes(uint32_t index) {
   display_attributes_[index].fps = mode.vrefresh;
   display_attributes_[index].vsync_period_ns =
     UINT32(1000000000L / display_attributes_[index].fps);
+  if (disp_type_ == DRMDisplayType::PERIPHERAL) {
+    char idle_mode[64] = {};
+    if (Debug::GetProperty(PRIMARY_IDLE_MODE_PROP, idle_mode) == kErrorNone &&
+        idle_mode == conn_mode.mode_name) {
+      display_attributes_[index].is_idle_config = true;
+      DLOGI("Found primary idle mode %s at index %u", idle_mode, index);
+    }
+  }
 
   /*
               Active                 Front           Sync           Back
@@ -1281,7 +1289,9 @@ void HWDeviceDRM::SetDisplaySwitchMode(uint32_t index) {
     panel_mode_changed_ = mode_flag;
   }
 
-  for (uint32_t mode_index = 0; mode_index < connector_info_.modes.size(); mode_index++) {
+  const uint32_t requested_mode_index = index;
+  for (uint32_t offset = 0; offset < connector_info_.modes.size(); offset++) {
+    uint32_t mode_index = (requested_mode_index + offset) % connector_info_.modes.size();
     if ((to_set.mode.vdisplay == connector_info_.modes[mode_index].mode.vdisplay) &&
         (to_set.mode.hdisplay == connector_info_.modes[mode_index].mode.hdisplay) &&
         (to_set.mode.vrefresh == connector_info_.modes[mode_index].mode.vrefresh) &&
@@ -1335,6 +1345,8 @@ void HWDeviceDRM::SetDisplaySwitchMode(uint32_t index) {
     current_mode.mode.vdisplay == to_set.mode.vdisplay) {
     seamless_mode_switch_ = true;
   }
+  DLOGI_IF(kTagDriverConfig, "Selected physical mode %u (%s)", current_mode_index_,
+           connector_info_.modes[current_mode_index_].mode_name.c_str());
 }
 
 DisplayError HWDeviceDRM::SetDisplayAttributes(uint32_t index) {
diff --git a/sdmclient/sdm_display.cpp b/sdmclient/sdm_display.cpp
index ca0b7be..b2af536 100644
--- a/sdmclient/sdm_display.cpp
+++ b/sdmclient/sdm_display.cpp
@@ -746,6 +746,11 @@ void SDMDisplay::UpdateConfigs() {
   for (uint32_t i = 0; i < num_configs_; i++) {
     DisplayConfigVariableInfo info = {};
     GetDisplayAttributesForConfig(INT(i), &info);
+    client_min_refresh_rate_ = std::min(client_min_refresh_rate_, info.fps);
+    if (info.is_idle_config) {
+      idle_real_config_ = i;
+      DLOGI("Registered physical idle config %u", i);
+    }
     bool config_exists = false;
     for (auto &config : variable_config_map_) {
       if (config.second == info) {
@@ -4098,6 +4103,12 @@ DisplayError SDMDisplay::GetSDMActiveConfig(bool get_real_config, Config *config
     return kErrorNone;
   }
 
+  if (real_config == active_real_config_override_ &&
+      variable_config_map_.find(active_config_index_) != variable_config_map_.end()) {
+    *config_index = active_config_index_;
+    return kErrorNone;
+  }
+
   if (variable_config_map_.find(active_config_index_) != variable_config_map_.end()) {
     auto &info = variable_config_map_[active_config_index_];
     if (info.is_virtual_config) {
@@ -4185,6 +4196,16 @@ DisplayError SDMDisplay::FinalizeDisplayConfig(bool check_pending_config, Config
 
   auto &info = variable_config_map_[new_config];
   Config new_real_config = (info.is_virtual_config) ? info.parent_config_index : new_config;
+  Config new_real_config_override = UINT_MAX;
+  if (type_ == kBuiltIn && idle_real_config_ != UINT_MAX &&
+      info.fps == client_min_refresh_rate_) {
+    DisplayConfigVariableInfo idle_info = {};
+    if (GetDisplayAttributesForConfig(INT(idle_real_config_), &idle_info) == kErrorNone &&
+        idle_info.x_pixels == info.x_pixels && idle_info.y_pixels == info.y_pixels) {
+      new_real_config = idle_real_config_;
+      new_real_config_override = new_real_config;
+    }
+  }
   Config current_real_config = 0;
   display_intf_->GetActiveConfig(&current_real_config);
   if (current_real_config != new_real_config) {
@@ -4197,6 +4218,7 @@ DisplayError SDMDisplay::FinalizeDisplayConfig(bool check_pending_config, Config
       return kErrorNotSupported;
     }
   }
+  active_real_config_override_ = new_real_config_override;
 
   auto current_config = active_config_index_;
   DLOGV_IF(kTagClient,
diff --git a/sdmclient/sdm_display.h b/sdmclient/sdm_display.h
index 804fd44..e137563 100644
--- a/sdmclient/sdm_display.h
+++ b/sdmclient/sdm_display.h
@@ -660,6 +660,9 @@ public:
   bool skip_commit_ = false;
   std::map<uint32_t, DisplayConfigVariableInfo> variable_config_map_;
   std::vector<uint32_t> sdm_config_map_;
+  Config idle_real_config_ = UINT_MAX;
+  Config active_real_config_override_ = UINT_MAX;
+  uint32_t client_min_refresh_rate_ = UINT_MAX;
   bool client_connected_ = true;
   bool pending_config_ = false;
   bool has_client_composition_ = false;
-- 
2.43.0

